{
  "openapi": "3.1.0",
  "info": {
    "title": "TickDesk cloud consumption profile (existing im-foundation)",
    "version": "1.0.0",
    "description": "已导入源码的消费子集，不是新增云端 API。业务 JSON 作为 TEXT content 透传；请同时遵循 docs/11。"
  },
  "servers": [
    {
      "url": "https://{host}:8443",
      "variables": {
        "host": {
          "default": "127.0.0.1",
          "description": "部署时替换为 IP SAN 对应公网 IP；示例不是线上地址"
        }
      }
    }
  ],
  "paths": {
    "/api/user/login": {
      "post": {
        "operationId": "login",
        "summary": "App 固定租户登录；持久化 Set-Cookie",
        "security": [],
        "responses": {
          "200": {
            "description": "成功；HTTP/IM 成功不代表 TickDesk 业务执行完成",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "const": 200
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/LoginData"
                    },
                    "success": {
                      "const": true
                    },
                    "timestamp": {
                      "type": "integer",
                      "format": "int64"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data",
                    "success",
                    "timestamp"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "可能多条；逐条交给 CookieJar，不以逗号拼接",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "认证/权限/参数/服务错误；不得解码为业务 ack",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-source": "im-foundation/rust/apps/api-server/src/modules/account/user/handlers.rs",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        }
      }
    },
